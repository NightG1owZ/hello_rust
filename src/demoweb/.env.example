# ============================================================================
# 环境变量示例文件
#
# 用法：复制为 .env 后按需修改（.env 已在 .gitignore 中，不会被提交）：
#   cp .env.example .env
#
# 优先级：环境变量 > config/default.toml > 代码内置默认值
# 命名规则：APP_ 前缀 + 配置路径，层级之间用双下划线 __ 分隔
#   server.bind_address  →  APP_SERVER__BIND_ADDRESS
#   database.url         →  APP_DATABASE__URL
#   jwt.secret           →  APP_JWT__SECRET
# ============================================================================

# 运行环境：development / test / production
APP_ENVIRONMENT=development

# ---- HTTP 服务 ----
APP_SERVER__BIND_ADDRESS=127.0.0.1:3000
APP_SERVER__REQUEST_TIMEOUT_SECS=15
APP_SERVER__MAX_BODY_BYTES=1048576
APP_SERVER__SHUTDOWN_TIMEOUT_SECS=10

# ---- 数据库 ----
# 内存库（默认）：零依赖，进程退出即清空
APP_DATABASE__URL=sqlite::memory:
# 文件库（持久化）：记得同时把连接数调大
# APP_DATABASE__URL=sqlite://data/app.db?mode=rwc
APP_DATABASE__MAX_CONNECTIONS=1
APP_DATABASE__ACQUIRE_TIMEOUT_SECS=5

# ---- JWT ----
# 生产环境必须替换为强随机值，例如：
#   openssl rand -base64 48
# 注意：environment=production 时若仍使用内置示例值，服务会拒绝启动
APP_JWT__SECRET=dev-only-insecure-secret-change-me
APP_JWT__EXPIRES_HOURS=24
APP_JWT__ISSUER=demoweb

# ---- 日志 ----
# 语法同 RUST_LOG；也可用 RUST_LOG 环境变量临时覆盖（优先级更高）
APP_LOG__LEVEL=info,demoweb=debug,tower_http=info
# 生产环境建议改为 true，交给 ELK/Loki 采集
APP_LOG__JSON=false
APP_LOG__FILE_ENABLED=false
APP_LOG__DIR=logs
